{
  "ConnectionStrings": {
    "PostgreSqlConnection": "Host=localhost;Port=5432;Database=rana_media_db;Username=postgres;Password=Reporting123@"
  },
  "JwtSettings": {
    "SecretKey": "RanaMedia-Super-Secret-Key-Min-32-Characters-2026!",
    "Issuer": "RanaMedia.API",
    "Audience": "RanaMedia.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromName": "Rana Media",
    "FromEmail": "noreply@ranamedia.co",
    "Username": "YOUR_SMTP_USER",
    "Password": "YOUR_SMTP_APP_PASSWORD"
  },
  "MediaStorageSettings": {
    "RootFolder": "wwwroot/uploads",
    "BasePublicPath": "/uploads",
    "MaxImageSizeMb": 10,
    "MaxVideoSizeMb": 25,
    "MaxAudioSizeMb": 100
  },
  "CommentSettings": {
    "RequireGuidelinesAcceptance": true,
    "MaxRootCommentsPerArticlePerUser": 1,
    "EditWindowMinutes": 60
  },
  "SeoAnalyzerSettings": {
    "SiteDomain": "ranamedia.co",
    "TitleMaxPixelWidth": 600,
    "MetaDescriptionMinLength": 120,
    "MetaDescriptionMaxLength": 156,
    "MinRecommendedWordCount": 300,
    "MinDensityPercent": 0.5,
    "MaxDensityPercent": 3.0
  },
  "TurnstileSettings": {
    "Enabled": false,
    "SecretKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Npgsql": "Error",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "RanaMedia"
    }
  }
}

